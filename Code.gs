const SHEET_NAME="Wedding RSVP";
function setup(){const p=PropertiesService.getScriptProperties();let id=p.getProperty("SPREADSHEET_ID"),ss;if(id){try{ss=SpreadsheetApp.openById(id)}catch(e){}}if(!ss){ss=SpreadsheetApp.create("Shivanshu & Upasana — Wedding RSVP");p.setProperty("SPREADSHEET_ID",ss.getId())}let sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0){sh.appendRow(["Timestamp","Name","Mobile","Attendance","Guests","Message"]);sh.setFrozenRows(1);sh.getRange(1,1,1,6).setFontWeight("bold").setBackground("#6c1021").setFontColor("#fff4df");sh.autoResizeColumns(1,6)}Logger.log("RSVP spreadsheet: "+ss.getUrl());return ss.getUrl()}
function doPost(e){const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");if(!id)return ContentService.createTextOutput("Setup required");const d=e&&e.parameter?e.parameter:{},name=String(d.name||"").trim().slice(0,90);if(!name)return ContentService.createTextOutput("Name required");const ss=SpreadsheetApp.openById(id),sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);sh.appendRow([new Date(),name,String(d.phone||"").slice(0,15),String(d.attendance||""),String(d.guests||"1"),String(d.message||"").slice(0,500)]);return ContentService.createTextOutput("OK")}
function doGet(){const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");return ContentService.createTextOutput(id?"RSVP endpoint is ready":"Run setup() first")}